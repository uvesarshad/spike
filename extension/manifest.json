{
  "manifest_version": 3,
  "name": "Browser QA Subagent",
  "version": "0.1.0",
  "description": "Autonomous browser QA: a cheap-model ladder tests your app in your real Chrome and reports back.",
  "background": { "service_worker": "sw.js" },
  "permissions": ["debugger", "tabs", "storage", "alarms", "offscreen", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "action": { "default_title": "Open QA side panel" },
  "side_panel": { "default_path": "panel.html" },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["overlay.js"],
      "run_at": "document_idle"
    }
  ]
}
