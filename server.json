{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.uvesarshad/spike",
  "description": "Browser QA for coding agents: checks a web change in real Chrome and returns a short verdict.",
  "repository": {
    "url": "https://github.com/uvesarshad/spike",
    "source": "github"
  },
  "version": "0.0.1",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "spike-agent",
      "version": "0.0.1",
      "runtimeHint": "npx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        }
      ]
    }
  ]
}
