{
  "name": "browser-qa-subagent",
  "version": "0.1.0",
  "description": "Browser QA/debug subagent: a cheap-model ladder drives a real Chrome and returns a ~2K-token verdict to your coding agent.",
  "type": "module",
  "license": "Apache-2.0",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qa": "dist/cli.js"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx test/e2e.run-fixture.ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "chrome-remote-interface": "^0.33.2",
    "commander": "^13.1.0",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
