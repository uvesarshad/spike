{
  "name": "browser-qa-subagent",
  "version": "0.1.0",
  "description": "Browser QA/debug subagent: a cheap-model ladder drives a real Chrome and returns a ~2K-token verdict to your coding agent.",
  "type": "module",
  "license": "Apache-2.0",
  "private": false,
  "keywords": [
    "browser",
    "qa",
    "testing",
    "chrome",
    "cdp",
    "chrome-devtools-protocol",
    "mcp",
    "ai-agent",
    "gemini-nano",
    "coding-agent",
    "claude-code"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/uvesarshad/browser-qa-subagent.git"
  },
  "homepage": "https://github.com/uvesarshad/browser-qa-subagent#readme",
  "bugs": {
    "url": "https://github.com/uvesarshad/browser-qa-subagent/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "qa": "dist/cli.js"
  },
  "files": [
    "dist",
    "extension",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup && tsup --config tsup.lite.config.ts",
    "build:lite": "tsup --config tsup.lite.config.ts",
    "dev": "tsx src/cli.ts",
    "typecheck": "tsc --noEmit",
    "test:e2e": "tsx test/e2e.run-fixture.ts",
    "gen:icons": "tsx scripts/gen-icons.ts",
    "pack:extension": "tsx scripts/pack-extension.ts",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.0",
    "buffer": "^6.0.3",
    "chrome-remote-interface": "^0.33.2",
    "commander": "^13.1.0",
    "gifenc": "^1.0.3",
    "jpeg-js": "^0.4.4",
    "ws": "^8.21.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/chrome-remote-interface": "^0.31.14",
    "@types/node": "^22.0.0",
    "@types/ws": "^8.18.1",
    "tsup": "^8.4.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
